# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Data outputs: everything under data/ is generated by the scripts and is never committed.
# Real partner data must never be committed either. Only the empty-folder markers are kept.
data/**
!data/*/
!data/*/.gitkeep
# The hand-made test folder keeps its instructions and template (but never the files people add).
!data/holdout/manual/
!data/holdout/manual/README.md
!data/holdout/manual/answer_key_template.csv
!data/holdout/manual/raw/
!data/holdout/manual/raw/.gitkeep

# Secrets: the pseudonymisation salt lives OUTSIDE the repository (see config/settings.yaml),
# but ignore any stray copy just in case.
*.salt
salt.txt
pseudonymisation_salt*
.env

# Dashboard entries and their backups (data/app/), and uploaded or replaced Excel files (data/raw/,
# data/app/replaced_files/) are all under data/ above. Any stray database copy elsewhere is ignored too.
*.db

# Generated reports and exports
*.duckdb
*.duckdb.wal

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
~$*.xlsx

# Evaluation results recorded while using the prototype (kept locally, not in git)
evaluation/report_generation_log.csv
